[Desktop Entry]
Type=Application
Name=FQShare
GenericName=Receive from phone
Comment=Receive Quick Share transfers from your phone without a shared network
Exec=sh -c "systemctl --user start fqshare.service && busctl --user call io.github.fqshare.FQShare /io/github/fqshare/FQShare io.github.fqshare.FQShare Receive"
Icon=smartphone
Terminal=false
Categories=Network;FileTransfer;
Keywords=quick share;nearby share;android;phone;bluetooth;
StartupNotify=false
