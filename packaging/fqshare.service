[Unit]
Description=FQShare: receive Quick Share transfers from your phone
Documentation=file://%h/.local/share/doc/fqshare/README.md
PartOf=graphical-session.target
After=graphical-session.target bluetooth.target

[Service]
Type=dbus
BusName=io.github.fqshare.FQShare
ExecStart=%h/.local/bin/fqshare
Restart=on-failure
RestartSec=5

# --- Sandbox ---------------------------------------------------------------
# FQShare only needs D-Bus (session + system), Bluetooth, IPv4/6 sockets for
# the Wi-Fi transfer, and write access to the download folder. Everything
# else is read-only or hidden. If you change download_dir in
# ~/.config/fqshare/config.toml, add it to ReadWritePaths with
#   systemctl --user edit fqshare
NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Downloads
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=graphical-session.target
